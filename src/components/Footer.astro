---
import { SITE_MENU, USER_FOOTER_SOCIAL_ICONS } from "@config";
import { Icon } from "astro-icon/components";
import { footer } from "@/content/site-pages.json";

const contact = SITE_MENU.find((item) => item.id === "contact");
const followLinks = [
  ...USER_FOOTER_SOCIAL_ICONS,
  { href: "/rss.xml", title: footer.rssLabel, svg: "ri:rss-line" },
  ...(contact
    ? [{ href: contact.href, title: contact.text, svg: contact.svg }]
    : []),
];
---

<footer class="rounded-xl bg-base-100/85 px-5 py-6 shadow-lg backdrop-blur-md sm:px-8">
  <nav aria-labelledby="footer-follow-links">
    <p id="footer-follow-links" class="font-bold">{footer.followTitle}</p>
    <ul class="mt-2 flex flex-wrap gap-2 text-sm font-medium">
      {followLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-base-content/10 bg-base-100/40 px-3 hover:border-primary/40 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <Icon name={link.svg} class="h-4 w-4 shrink-0 opacity-75" aria-hidden="true" />
            {link.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <p class="mt-4 border-t border-base-content/15 pt-4 text-xs text-base-content/75">
    主题采用 <a href="https://github.com/EveSunMaple/Frosti" class="link link-hover">Frosti</a>
    · © {new Date().getFullYear()} <a href="https://frosti.saroprock.com/" class="link link-hover">EveSunMaple</a>
  </p>
</footer>
