---
import { USER_AVATAR } from "@config";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import { about } from "@/content/site-pages.json";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title={about.title}>
  <MainCard title={about.heading} image={about.image} infoIcon="lucide:user">
    <div class="space-y-10 mb-8">
      <section class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <div class="avatar">
          <div class="w-32 h-32 md:w-40 md:h-40 rounded-xl ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden">
            <img src={USER_AVATAR} alt="头像" width="160" height="160" loading="eager" />
          </div>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl md:text-4xl font-bold mb-2">{about.name}</h1>
          <p class="text-xl text-base-content/80 mb-4">{about.education}</p>
          <div class="flex flex-wrap gap-3 justify-center md:justify-start mb-6">
            {about.actions.map((action) => (
              <a href={action.href} target={action.target} rel={action.target === "_blank" ? "noopener noreferrer" : undefined} class="btn btn-sm btn-outline gap-2">
                {action.icon && <Icon name={action.icon} class="w-4 h-4" aria-hidden="true" />}
                <span>{action.label}</span>
              </a>
            ))}
          </div>
          <p class="whitespace-pre-line text-base-content/80">{about.bio}</p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:brain-circuit" class="w-6 h-6 text-primary" aria-hidden="true" />
          <span>{about.keywordsTitle}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {about.keywords.map((keyword) => (
            <div class="card bg-base-200 p-5">
              <h3 class="font-bold mb-2">{keyword.title}</h3>
              <p class="whitespace-pre-line text-base-content/80">{keyword.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:code-2" class="w-6 h-6 text-primary" aria-hidden="true" />
          <span>{about.skillsTitle}</span>
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {about.skills.map((tech) => (
            <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors">
              <div class="mb-2 text-3xl" style={`color: ${tech.color}`}>
                <Icon name={tech.icon} class="w-10 h-10" aria-hidden="true" />
              </div>
              <span class="text-sm font-medium text-center">{tech.name}</span>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="competition-title">
        <h2 id="competition-title" class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:trophy" class="w-6 h-6 text-primary" aria-hidden="true" />
          <span>{about.competitionsTitle}</span>
        </h2>
        <div class="grid gap-4 xl:grid-cols-2 xl:items-start">
          {about.competitions.map((period) => (
            <section aria-labelledby={period.id} class="min-w-0 rounded-xl bg-base-200 px-4 py-5 sm:px-5">
              <p class="text-sm text-base-content/70">{period.date}</p>
              <h3 id={period.id} class="mt-1 text-lg font-bold">{period.title}</h3>
              <ul class="mt-3 divide-y divide-base-content/10 border-t border-base-content/10 text-sm">
                {period.results.map(([event, award]) => (
                  <li class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-3 py-2">
                    <span>{event}</span>
                    <span class="whitespace-nowrap text-right font-semibold">{award}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>
