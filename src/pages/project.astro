---
import { Icon } from "astro-icon/components";
import Card from "@/components/temple/Card.astro";
import { projectGroups } from "@/content/projects";
import { projects } from "@/content/site-pages.json";
import {
  editorPath,
  isLocalEditor,
  projectFields,
  projectRevision,
} from "@/integration/projectEditor";
import BaseLayout from "@/layouts/BaseLayout.astro";

const localEditor = import.meta.env.DEV && isLocalEditor(Astro.url.hostname);
---

<BaseLayout title={projects.title} description={projects.description}>
  <Card class="px-5 py-6 sm:px-8 sm:py-7">
    <h1 class="text-3xl font-extrabold sm:text-4xl">{projects.title}</h1>
  </Card>
  {projectGroups.map((group) => (
    <Card class="px-5 py-6 sm:px-8 sm:py-7">
      <section aria-labelledby={group.id}>
        <h2 id={group.id} class="mb-3 text-xl font-bold sm:text-2xl">{group.title}</h2>
        <div class="divide-y divide-base-content/10">
          {group.items.map((project) => (
            <details class="group/project rounded-sm">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-3 rounded-sm py-4 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
                <span class="grid min-w-0 flex-1 gap-x-3 gap-y-1 break-words sm:grid-cols-[5.5rem_minmax(0,1fr)]">
                  <span class="text-sm font-medium leading-7 text-base-content/70 sm:row-span-2">{project.type}</span>
                  <span class="text-lg font-bold">{project.title}</span>
                  <span class="mt-1 block max-w-prose leading-relaxed text-base-content/85">{project.summary}</span>
                </span>
                <Icon name="lucide:chevron-down" class="mt-2 h-5 w-5 shrink-0 group-open/project:rotate-180" aria-hidden="true" />
              </summary>
              <div id={project.id} class="scroll-mt-28 pb-5 sm:pl-[6.25rem]">
                {project.detail && (
                  <p class="max-w-prose whitespace-pre-line break-words leading-relaxed text-base-content/80">{project.detail}</p>
                )}
                {project.link && (
                  <a href={project.link.href} class="link mt-2 inline-block font-semibold">{project.link.label}</a>
                )}
                {project.photo && (
                  <figure class="mt-4 max-w-sm">
                    <img
                      src={project.photo.src}
                      alt=""
                      width={project.photo.width}
                      height={project.photo.height}
                      loading="lazy"
                      decoding="async"
                      class="h-auto w-full rounded-lg"
                    />
                    <figcaption class="mt-2 text-sm text-base-content/75">{project.photo.caption}</figcaption>
                  </figure>
                )}
                {localEditor && (
                  <details class="mt-4 rounded-lg border border-base-content/15 bg-base-200 p-4">
                    <summary class="cursor-pointer font-semibold">编辑这项作品</summary>
                    <form action={editorPath} method="post" data-astro-reload class="mt-3 grid gap-3">
                      <input type="hidden" name="id" value={project.id} />
                      <input type="hidden" name="revision" value={projectRevision(project)} />
                      {projectFields.map(({ name, label, maxLength }) => (
                        <label class="grid gap-1 text-sm font-medium">
                          {label}
                          {name === "summary" || name === "detail" ? (
                            <textarea
                              name={name}
                              maxlength={maxLength}
                              required={name === "summary"}
                              rows={name === "summary" ? 2 : 4}
                              class="textarea textarea-bordered w-full"
                            >{project[name] ?? ""}</textarea>
                          ) : (
                            <input
                              name={name}
                              maxlength={maxLength}
                              required
                              value={project[name]}
                              class="input input-bordered w-full"
                            />
                          )}
                        </label>
                      ))}
                      <div class="flex flex-wrap items-center gap-3">
                        <button type="submit" class="btn btn-primary btn-sm">保存到本地</button>
                        <small>改动写回项目文件，可在 Git 中查看。</small>
                      </div>
                    </form>
                  </details>
                )}
                {localEditor && (
                  <p id={`saved-${project.id}`} role="status" class="mt-3 hidden scroll-mt-28 text-sm font-medium target:block">
                    已保存到本地。
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    </Card>
  ))}
</BaseLayout>
