---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
import { friends } from "@/content/site-pages.json";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title={friends.title}>
  <MainCard title={friends.title} image={friends.image} infoIcon="lucide:link">
    <section>
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:users" class="w-6 h-6 text-primary" aria-hidden="true" />
        <span>{friends.heading}</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {friends.items.map((friend) => (
          <FriendCard {...friend} type={friend.type === "tech" || friend.type === "contributor" ? friend.type : "friend"} />
        ))}
      </div>
    </section>
    <div class="divider my-8">
      <Icon name="lucide:heart" class="w-10 h-10 text-primary" aria-hidden="true" />
    </div>
  </MainCard>
</BaseLayout>
